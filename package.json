{
  "name": "smil-2-gif",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Animated SVG diagrams (SMIL) exported to GIF/WebM/MP4 via Playwright + ffmpeg",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "gen": "node scripts/gen-all.mjs",
    "gif:hero": "node scripts/svg-to-gif.mjs src/diagrams/hero-terminal/hero-terminal.svg gifs/hero-terminal.gif --duration 7.5",
    "gif:architecture": "node scripts/svg-to-gif.mjs src/diagrams/architecture/architecture.svg gifs/architecture.gif --duration 12.5 --fps 24",
    "gif:memory-hierarchy": "node scripts/svg-to-gif.mjs src/diagrams/memory-hierarchy/memory-hierarchy.svg gifs/memory-hierarchy.gif --duration 12 --fps 24",
    "video:memory-hierarchy": "node scripts/svg-to-gif.mjs src/diagrams/memory-hierarchy/memory-hierarchy.svg gifs/memory-hierarchy.webm --duration 12 --fps 24 --format webm",
    "check:memory-hierarchy": "node scripts/check-memory-hierarchy.mjs",
    "check:hero": "node scripts/check-hero.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "playback": "node scripts/playback-check.mjs",
    "playback:architecture": "node scripts/playback-architecture.mjs",
    "video:chart-lab": "node scripts/mockup-to-video.mjs --mockup chart-lab --duration 8 --fps 30 --width 1200 --height 720 --format mp4",
    "webm:chart-lab": "node scripts/mockup-to-video.mjs --mockup chart-lab --duration 8 --fps 30 --width 1200 --height 720 --format webm",
    "gif:chart-lab": "node scripts/mockup-to-video.mjs --mockup chart-lab --duration 8 --fps 24 --width 900 --height 540 --format gif --dither none",
    "preview:chart-lab": "node scripts/mockup-to-video.mjs --mockup chart-lab --duration 1 --fps 15 --width 1200 --height 720 --format mp4 --preview gifs/chart-lab-preview.png --no-gifsicle",
    "gif:motherboard": "node scripts/motherboard-to-gif.mjs gifs/motherboard.gif"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/charts": "^0.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gifsicle": "^7.0.1",
    "lucide-react": "^1.31.0",
    "playwright": "^1.49.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.3",
    "vite": "^7.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "gifsicle@7.0.1": true
  }
}